@model BookSto.Domain.Models.Category
@{
    ViewData["Title"] = "Add New Category";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Add New Category</h2>

<form asp-area="Admin" asp-controller="Category" asp-action="Create" method="post" class="w-100" autocomplete="off">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Name" class="form-label fw-bold"></label>
        <input asp-for="Name" class="form-control" placeholder="Category name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>



