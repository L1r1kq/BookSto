@using BookSto.WebAPI.ViewModels
@model UserEditViewModel
@{
    ViewData["Title"] = "Edit user";
    var allRoles   = (IEnumerable<string>)ViewBag.AllRoles;
}

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm rounded-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Edit user (@Model.UserName)</h4>
        <a asp-action="Index" class="btn btn-sm btn-secondary d-flex align-items-center">
          <i class="ph ph-arrow-left me-1"></i>Back
        </a>
      </div>

      <div class="card-body">
        <!-- ОБЯЗАТЕЛЬНО выводим ошибки -->
        

        <form asp-action="Edit" method="post" class="row g-3">
          @Html.AntiForgeryToken()
          <input asp-for="Id" type="hidden"/>

          <div class="col-md-6">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" disabled />
          </div>

          <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
          </div>

          <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
          </div>

          <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
          </div>

          <!-- роли -->
          <div class="col-12">
            <label class="form-label fw-semibold">Roles</label>
            <select asp-for="SelectedRoles"
                    asp-items="@(new MultiSelectList(allRoles, Model.SelectedRoles))"
                    multiple="multiple"
                    class="form-select"
                    size="@(Math.Min(allRoles.Count(), 6))">
            </select>
          </div>

          <div class="col-12 d-flex justify-content-end gap-2 mt-3">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              <i class="ph ph-check me-1"></i>Save
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
