@model BookSto.Application.DTOs.CreateBookRequestDto
@{
    ViewData["Title"] = "Add Book";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<form asp-action="Create" asp-area="Admin" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    <!-- Title -->
    <div class="form-group mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Dune" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <!-- Category -->
    <div class="form-group mb-3">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">Select Category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <!-- Author -->
    <div class="form-group mb-3">
        <label asp-for="AuthorId" class="form-label">Author</label>
        <select asp-for="AuthorId" asp-items="ViewBag.Authors" class="form-select">
            <option value="">Select Author</option>
        </select>
        <span asp-validation-for="AuthorId" class="text-danger"></span>
    </div>

    <!-- Image URL -->
    <div class="form-group mb-3">
        <label asp-for="ImageUrl" class="form-label">Cover image URL</label>
        <input asp-for="ImageUrl" class="form-control" placeholder="https://.../image.jpg" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <!-- PDF URL -->
    <div class="form-group mb-3">
        <label asp-for="PdfUrl" class="form-label">PDF URL</label>
        <input asp-for="PdfUrl" class="form-control" placeholder="https://.../book.pdf" />
        <span asp-validation-for="PdfUrl" class="text-danger"></span>
    </div>

    <!-- Price -->
    <div class="form-group mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="9.99" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <!-- Rating -->
    <div class="form-group mb-3">
        <label asp-for="Rating" class="form-label"></label>
        <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="5" placeholder="4.5" />
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>

    <!-- Description -->
    <div class="form-group mb-4">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Short synopsis…"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
